# Microsoft Office temporary lock files (the ~$ files)
~$*
*.tmp

# Personal working notes - keep these OUT of the website repo
# (the whole repo is served publicly, so notes should not live here)
*.docx
*.xlsx
*.doc
*.xls

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Python build cache
__pycache__/
*.pyc

# Claude scratch chunk files (if any)
_c*.json
_all.json
_b4c*.json

# Node dependencies - never commit to the public site repo
node_modules/
